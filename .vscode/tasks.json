
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "FerrOS: Build",
            "type": "shell",
            "command": "cargo",
            "args": ["build"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "FerrOS: Run Pi 4",
            "type": "shell",
            "command": "qemu-system-aarch64",
            "args": [
                "-machine", "raspi4b",
                "-display", "none",
                "-serial", "stdio",
                "-monitor", "none",
                "-kernel",
                "target/aarch64-unknown-none/debug/ferros"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "FerrOS: Build",
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "FerrOS: Start Pi 4 for Debugging",
            "type": "shell",
            "command": "qemu-system-aarch64",
            "args": [
                "-machine", "raspi4b",
                "-display", "none",
                "-serial", "stdio",
                "-monitor", "none",
                "-kernel",
                "target/aarch64-unknown-none/debug/ferros",
                "-S",
                "-gdb", "tcp::1234"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "FerrOS: Build",
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
